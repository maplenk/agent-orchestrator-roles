#!/bin/bash
set -euo pipefail

provider="${AO_ACCEPTANCE_PROVIDER:-$(basename "$0")}"
data_dir="${AO_DATA_DIR:-}"
session_id="${AO_SESSION_ID:-}"

# Adapter discovery/version probes are not managed sessions. They must be
# finite so an acceptance daemon can discover the stub without hanging.
if [[ -z "$data_dir" || -z "$session_id" ]]; then
	printf '%s\n' "AO acceptance ${provider} stub"
	exit 0
fi

root="$(cd "$(dirname "$data_dir")" && pwd -P)"
if [[ ! -f "$root/.ao-mvp-acceptance" || "$data_dir" != "$root/data" ]]; then
	printf '%s\n' "acceptance provider refused unscoped AO_DATA_DIR=$data_dir" >&2
	exit 70
fi

control="$root/control/provider/${session_id}.${provider}"
events="$root/evidence/provider-events.log"
mkdir -p "$(dirname "$control")" "$(dirname "$events")"
printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$session_id" "$provider" "launch" >>"$events"

on_exit() {
	printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$session_id" "$provider" "exit" >>"$events"
}
trap on_exit EXIT
trap 'exit 0' HUP INT TERM

while true; do
	mode="hold"
	if [[ -f "$control" ]]; then
		mode="$(tr -d '[:space:]' <"$control")"
	fi
	case "$mode" in
	hold | "") ;;
	exit) exit 0 ;;
	fail) exit 42 ;;
	*)
		printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$session_id" "$provider" "bad-mode:$mode" >>"$events"
		exit 71
		;;
	esac

	# Consume PTY input so post-ack evidence can prove that an allowed write
	# reached the target. Record only byte count and digest, never prompt text.
	line=""
	if IFS= read -r -t 0.10 line; then
		bytes="$(printf %s "$line" | wc -c | tr -d '[:space:]')"
		digest="$(printf %s "$line" | shasum -a 256 | awk '{print $1}')"
		printf '%s\t%s\t%s\tinput-bytes=%s\tsha256=%s\n' \
			"$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$session_id" "$provider" "$bytes" "$digest" >>"$events"
	fi
done
